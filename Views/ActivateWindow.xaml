<Window x:Class="BnetSwitch.ActivateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:BnetSwitch.Controls"
        Title="激活去广告" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="376" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Border Background="{DynamicResource Win}" CornerRadius="12" Margin="16"
            BorderBrush="{DynamicResource Bd}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="15,13,15,0" MouseLeftButtonDown="OnDrag">
                <StackPanel Orientation="Horizontal">
                    <ctrl:IconView Geometry="{StaticResource GeoKey}" Stroke="{DynamicResource Acc}" Thickness="2" IconSize="15" Margin="0,0,8,0" />
                    <TextBlock Text="激活去广告" Foreground="{DynamicResource Tx1}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource TitleIconButton}" HorizontalAlignment="Right" Click="OnCancel" Width="26" Height="26">
                    <ctrl:IconView Geometry="{StaticResource GeoX}" Stroke="{DynamicResource Tx3}" Thickness="2" IconSize="14" />
                </Button>
            </Grid>

            <StackPanel Margin="15,10,15,0">
                <TextBlock Text="输入激活码,永久去广告(一码绑定一台设备)。" Foreground="{DynamicResource Tx2}" FontSize="12.5" TextWrapping="Wrap" />
                <TextBox x:Name="CodeBox" Style="{StaticResource InputBox}" Margin="0,9,0,0" Height="36"
                         FontFamily="Consolas" FontSize="14" CharacterCasing="Upper" />
                <Border Background="{DynamicResource Body}" CornerRadius="7" Padding="9,7" Margin="0,9,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource TitleIconButton}" Width="24" Height="24" Click="OnCopyMachine" ToolTip="复制本机标识">
                            <ctrl:IconView Geometry="{StaticResource GeoCopy}" Stroke="{DynamicResource Acc}" Thickness="2" IconSize="13" />
                        </Button>
                        <TextBlock x:Name="MachineText" Foreground="{DynamicResource TagTx}" FontSize="11" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
                <TextBlock x:Name="StatusText" Foreground="#E5556A" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Margin="0,9,0,0">
                    <Hyperlink Click="OnSponsor" Foreground="{DynamicResource Acc}" TextDecorations="None">
                        <Run Text="还没有激活码?点这里赞助获取 →" FontSize="12" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <Grid Margin="15,14,15,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Height="32" Padding="16,0" Margin="0,0,8,0" Click="OnCancel" Content="取消" FontSize="12.5" />
                    <Button Style="{StaticResource AccentButton}" Height="32" Padding="18,0" Click="OnActivate" Content="激活" FontSize="12.5" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
