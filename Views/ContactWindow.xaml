<Window x:Class="BnetSwitch.ContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:BnetSwitch.Controls"
        Title="联系开发者" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="380" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Border Background="{DynamicResource Win}" CornerRadius="12" Margin="16"
            BorderBrush="{DynamicResource Bd}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="15,13,15,0" MouseLeftButtonDown="OnDrag">
                <StackPanel Orientation="Horizontal">
                    <ctrl:IconView Geometry="{StaticResource GeoChat}" Stroke="{DynamicResource Acc}" Thickness="2" IconSize="15" Margin="0,0,8,0" />
                    <TextBlock Text="联系开发者" Foreground="{DynamicResource Tx1}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource TitleIconButton}" HorizontalAlignment="Right" Click="OnClose" Width="26" Height="26">
                    <ctrl:IconView Geometry="{StaticResource GeoX}" Stroke="{DynamicResource Tx3}" Thickness="2" IconSize="14" />
                </Button>
            </Grid>

            <StackPanel Margin="15,12,15,15">
                <TextBlock Text="有问题、建议或想交流,欢迎来找我 👇" Foreground="{DynamicResource Tx2}" FontSize="12.5" Margin="0,0,0,10" />

                <!-- QQ 交流群 -->
                <Border x:Name="QQRow" CornerRadius="10" BorderBrush="{DynamicResource BtnBd}" BorderThickness="1"
                        Background="{DynamicResource Card}" Padding="11,10" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonUp="OnQQ">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccSoft}" Margin="0,0,11,0">
                            <ctrl:IconView Geometry="{StaticResource GeoChat}" Stroke="{DynamicResource Acc}" Thickness="2" IconSize="19" />
                        </Border>
                        <ctrl:IconView DockPanel.Dock="Right" Geometry="{StaticResource GeoExt}" Stroke="{DynamicResource Tx3}" Thickness="2" IconSize="15" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="加入 QQ 交流群" Foreground="{DynamicResource Tx1}" FontWeight="Medium" FontSize="13" />
                            <TextBlock Text="反馈问题 · 交流 · 抢先拿新版" Foreground="{DynamicResource Tx3}" FontSize="11" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- GitHub -->
                <Border x:Name="GhRow" CornerRadius="10" BorderBrush="{DynamicResource BtnBd}" BorderThickness="1"
                        Background="{DynamicResource Card}" Padding="11,10" Cursor="Hand" MouseLeftButtonUp="OnGithub">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccSoft}" Margin="0,0,11,0">
                            <ctrl:IconView Geometry="{StaticResource GeoCode}" Stroke="{DynamicResource Acc}" Thickness="2" IconSize="19" />
                        </Border>
                        <ctrl:IconView DockPanel.Dock="Right" Geometry="{StaticResource GeoExt}" Stroke="{DynamicResource Tx3}" Thickness="2" IconSize="15" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="GitHub 项目主页 · 下载最新版" Foreground="{DynamicResource Tx1}" FontWeight="Medium" FontSize="13" />
                            <TextBlock Text="历史版本 · 点个 Star ⭐ 支持作者" Foreground="{DynamicResource Tx3}" FontSize="11" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
