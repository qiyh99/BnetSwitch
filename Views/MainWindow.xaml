<Window x:Class="BnetSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:BnetSwitch.Controls"
        Title="战网账号切换管理器" Height="640" Width="920" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Win}" Foreground="{DynamicResource Tx1}"
        Icon="pack://application:,,,/Assets/app.ico"
        FontFamily="Microsoft YaHei UI" FontSize="13" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <!-- GlassFrameThickness 留 1px 让 DWM 画原生阴影;圆角在代码里用 DWMWA_WINDOW_CORNER_PREFERENCE 开 -->
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource Win}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 标题栏 ===== -->
        <Border Grid.Row="0" Background="{DynamicResource Win}" BorderBrush="{DynamicResource Bd2}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="14,0">
                <Grid DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,9,0">
                    <ctrl:IconView Geometry="{StaticResource GeoLogoOuter}" Stroke="{DynamicResource Acc}" Thickness="2" IconSize="18" />
                    <ctrl:IconView Geometry="{StaticResource GeoLogoInner}" Fill="{DynamicResource Acc}" IconSize="18" />
                </Grid>
                <TextBlock DockPanel.Dock="Left" Text="战网账号切换管理器" VerticalAlignment="Center"
                           Foreground="{DynamicResource Tx1}" FontSize="13" />

                <!-- 非强制的新版只在这挂个小标,不拦人。强制版本压根走不到主界面,不会出现在这。 -->
                <Button DockPanel.Dock="Left" Style="{StaticResource TitleIconButton}" Width="Auto" Padding="8,0" Margin="12,0,0,0"
                        Click="OnOpenUpdate" Visibility="{Binding UpdateBadgeVisibility}"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="查看更新说明并升级">
                    <Border Background="{DynamicResource AccSoft}" CornerRadius="9" Padding="8,2">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:IconView Geometry="{StaticResource GeoDownload}" Stroke="{DynamicResource Acc}" Thickness="2" IconSize="12" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding UpdateBadgeText}" Foreground="{DynamicResource Acc}" FontSize="11.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Button>

                <Button DockPanel.Dock="Right" Style="{StaticResource TitleIconButton}" Click="OnCloseClick"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="关闭">
                    <ctrl:IconView Geometry="{StaticResource GeoX}" Stroke="{DynamicResource Tx3}" Thickness="2" IconSize="15" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource TitleIconButton}" Click="OnMaximize"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="最大化 / 还原">
                    <Border Width="10" Height="9" BorderBrush="{DynamicResource Tx3}" BorderThickness="1.4" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource TitleIconButton}" Click="OnMinimize"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="最小化">
                    <Border Width="11" Height="1.4" Background="{DynamicResource Tx3}" VerticalAlignment="Center" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource TitleIconButton}" Width="Auto" Padding="8,0" Click="OnOpenSettings"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="设置">
                    <ctrl:IconView Geometry="{StaticResource GeoGear}" Stroke="{DynamicResource Tx3}" Thickness="2" IconSize="16" />
                </Button>
                <Border DockPanel.Dock="Right" Width="1" Height="15" VerticalAlignment="Center" Margin="8,0"
                        Background="{DynamicResource Bd}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource TitleIconButton}" Width="Auto" Padding="8,0" Margin="0,0,2,0" Click="OnContact"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="联系开发者(QQ 群 / GitHub)">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:IconView Geometry="{StaticResource GeoChat}" Stroke="{DynamicResource Tx3}" Thickness="2" IconSize="14" Margin="0,0,4,0" />
                        <TextBlock Text="联系开发者" Foreground="{DynamicResource Tx3}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1" Background="{DynamicResource Body}">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="234" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左:身份卡 -->
                <StackPanel Grid.Column="0">
                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Bd3}" BorderThickness="1"
                            CornerRadius="14" Padding="16" Visibility="{Binding HasCurrentVisibility}">
                        <StackPanel>
                            <Border Width="60" Height="60" CornerRadius="30" HorizontalAlignment="Left" Background="{DynamicResource AccSoft}">
                                <TextBlock Text="{Binding CurrentAccount.AvatarText}" Foreground="{DynamicResource Acc}"
                                           FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Margin="0,12,0,0" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Tx1}">
                                <Run Text="{Binding CurrentAccount.NameOnly, Mode=OneWay}" />
                                <Run Text="{Binding CurrentAccount.HashTag, Mode=OneWay}" Foreground="{DynamicResource Tx3}" FontWeight="Normal" />
                            </TextBlock>
                            <TextBlock Text="{Binding CurrentAccount.AccountIdText}" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource Tx3}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border CornerRadius="10" Background="{DynamicResource OkSoft}" Padding="9,3">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Ok}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="当前登录中" Foreground="{DynamicResource OkTx}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="10" Padding="9,3" Margin="6,0,0,0"
                                        Visibility="{Binding CurrentAccount.RegionVisibility}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource TagBg}" />
                                            <Style.Triggers>
                                                <!-- 国际服/亚服用主题色标出来,和右侧列表一致 -->
                                                <DataTrigger Binding="{Binding CurrentAccount.IsCnRegion}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource AccSoft}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding CurrentAccount.RegionText, Mode=OneWay}" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Tx2}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentAccount.IsCnRegion}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Acc}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource Bd2}" Margin="0,14" />
                            <!-- 每次开工具都要用的动作放最上面:直接上当前这个号,不用自己再去找战网图标 -->
                            <Button Style="{StaticResource AccentButton}" Click="OnLaunchClient" Margin="0,0,0,8" IsEnabled="{Binding NotBusy}">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:IconView Geometry="{StaticResource GeoPower}" Stroke="{DynamicResource OnAcc}" Thickness="2" IconSize="16" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding LaunchText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="OnSaveCurrent" Margin="0,0,0,8" IsEnabled="{Binding NotBusy}">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:IconView Geometry="{StaticResource GeoCam}" Stroke="{DynamicResource Tx1}" Thickness="2" IconSize="16" Margin="0,0,7,0" />
                                    <TextBlock Text="保存当前为快照" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="OnAddAccount" IsEnabled="{Binding NotBusy}">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:IconView Geometry="{StaticResource GeoUser}" Stroke="{DynamicResource Tx1}" Thickness="2" IconSize="16" Margin="0,0,7,0" />
                                    <TextBlock Text="登录新号" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="OnOpenStats" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:IconView Geometry="{StaticResource GeoChart}" Stroke="{DynamicResource Tx1}" Thickness="2" IconSize="16" Margin="0,0,7,0" />
                                    <TextBlock Text="查战绩" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Bd3}" BorderThickness="1"
                            CornerRadius="14" Padding="16" Visibility="{Binding NoCurrentVisibility}">
                        <StackPanel>
                            <TextBlock Text="未检测到当前登录" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Tx1}" />
                            <TextBlock Text="先在战网登录一个账号,登录成功后这里会自动识别。" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Tx3}" />
                            <Border Height="1" Background="{DynamicResource Bd2}" Margin="0,14" />
                            <!-- 没识别到当前号,多半就是战网还没开:先给个启动入口,别让人卡在这张空卡片上 -->
                            <Button Style="{StaticResource AccentButton}" Click="OnLaunchClient" Margin="0,0,0,8" IsEnabled="{Binding NotBusy}">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:IconView Geometry="{StaticResource GeoPower}" Stroke="{DynamicResource OnAcc}" Thickness="2" IconSize="16" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding LaunchText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="OnAddAccount" IsEnabled="{Binding NotBusy}">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:IconView Geometry="{StaticResource GeoUser}" Stroke="{DynamicResource Tx1}" Thickness="2" IconSize="16" Margin="0,0,7,0" />
                                    <TextBlock Text="登录新号" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="2,12,0,0">
                        <ctrl:IconView Geometry="{StaticResource GeoWarn}" Stroke="{DynamicResource WarnIc}" Thickness="2" IconSize="15"
                                       VerticalAlignment="Top" Margin="0,1,6,0" />
                        <TextBlock Text="切号只用右侧按钮,别在战网里点「退出登录」。" TextWrapping="Wrap" Width="196"
                                   FontSize="11.5" Foreground="{DynamicResource WarnTx}" LineHeight="17" />
                    </StackPanel>
                </StackPanel>

                <!-- 右:分组列表 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 搜索:名字 / 备注 / 段位,边打边过滤(纯内存重排,不读库不联网)-->
                    <Border Grid.Row="0" Margin="2,0,2,10" Height="32" CornerRadius="8" Padding="10,0"
                            Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBd}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ctrl:IconView Grid.Column="0" Geometry="{StaticResource GeoSearch}" Stroke="{DynamicResource Tx3}"
                                           Thickness="2.4" IconSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource Tx1}" CaretBrush="{DynamicResource Tx1}" FontSize="12.5"
                                     VerticalContentAlignment="Center" Padding="0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="1" Text="搜索名字 / 备注 / 段位" FontSize="12.5" IsHitTestVisible="False"
                                       Foreground="{DynamicResource Tx3}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=SearchBox}" Value="" />
                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Style="{StaticResource TitleIconButton}" Width="20" Height="20"
                                    Click="OnClearSearch" ToolTip="清空" Visibility="{Binding ClearSearchVisibility}">
                                <ctrl:IconView Geometry="{StaticResource GeoX}" Stroke="{DynamicResource Tx3}" Thickness="2.6" IconSize="9" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 用 DockPanel:两个按钮钉在右边,中间那条段位进度提示自己吃掉剩下的宽度并截断,
                         不会把按钮顶出可视区(Dock=Right 先声明的在最右,所以「刷新段位」写在前面)-->
                    <DockPanel Grid.Row="1" Margin="2,2,2,10">
                        <TextBlock DockPanel.Dock="Left" Text="可秒切" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Tx1}" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ReadyCountText}" FontSize="12" Foreground="{DynamicResource Tx3}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource TitleIconButton}" Click="OnRefreshRanks" IsEnabled="{Binding NotBusy}"
                                ToolTip="刷新段位(要联网查询;国服号需要扫码登录网易大神)">
                            <ctrl:IconView Geometry="{StaticResource GeoChart}" Stroke="{DynamicResource Tx3}" Thickness="2" IconSize="15" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource TitleIconButton}" Click="OnRefresh" ToolTip="刷新" Margin="8,0,0,0">
                            <ctrl:IconView Geometry="{StaticResource GeoRefresh}" Stroke="{DynamicResource Tx3}" Thickness="2" IconSize="16" />
                        </Button>
                        <TextBlock Text="{Binding RankStatusText}" Visibility="{Binding RankStatusVisibility}"
                                   ToolTip="{Binding RankStatusText}" FontSize="11.5" Foreground="{DynamicResource Tx3}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,4,0"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <ScrollViewer x:Name="RightScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RightStack">
                            <ItemsControl ItemsSource="{Binding ReadyAccounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CardRoot" HorizontalAlignment="Left"
                                                Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                Background="{DynamicResource Card}" BorderBrush="{DynamicResource Bd3}"
                                                BorderThickness="1" CornerRadius="11" Padding="9,8" Margin="0,0,0,8" Cursor="Hand"
                                                MouseLeftButtonDown="OnCardDown" MouseLeftButtonUp="OnSwitchCard">
                                            <Border.ContextMenu>
                                                <ContextMenu Style="{StaticResource CardMenu}" Opened="OnCardMenuOpened" Closed="OnCardMenuClosed">
                                                    <MenuItem Style="{StaticResource CardMenuItem}" Header="编辑备注" Click="OnEditNote" />
                                                    <MenuItem Style="{StaticResource CardMenuItem}" Header="{Binding PinMenuText}" Click="OnTogglePin" />
                                                    <Separator Style="{StaticResource CardMenuSeparator}" />
                                                    <MenuItem Style="{StaticResource CardMenuItemDanger}" Header="删除此快照" Click="OnDeleteCard" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="19" Background="{Binding AvatarBg}">
                                                    <TextBlock Text="{Binding AvatarText}" Foreground="{Binding AvatarFg}" FontSize="15" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border x:Name="GoPill" DockPanel.Dock="Right" CornerRadius="8" Background="{DynamicResource AccSoft}" Padding="12,6" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ctrl:IconView x:Name="GoIcon" Geometry="{StaticResource GeoSwitch}" Stroke="{DynamicResource Acc}" Thickness="2" IconSize="14" Margin="0,0,5,0" />
                                                        <TextBlock x:Name="GoText" Text="{Binding SwitchText, Mode=OneWay}" Foreground="{DynamicResource Acc}" FontSize="12.5" />
                                                    </StackPanel>
                                                </Border>
                                                <Button x:Name="DelBtn" DockPanel.Dock="Right" Style="{StaticResource TitleIconButton}"
                                                        Width="30" Height="30" Margin="0,0,4,0" Click="OnDeleteCard" ToolTip="删除此快照"
                                                        Visibility="Collapsed">
                                                    <ctrl:IconView x:Name="DelIcon" Geometry="{StaticResource GeoDelete}" Stroke="{DynamicResource Tx3}" Thickness="2" IconSize="15" />
                                                </Button>
                                                <StackPanel Margin="11,0" VerticalAlignment="Center">
                                                    <DockPanel>
                                                        <ctrl:IconView DockPanel.Dock="Left" Geometry="{StaticResource GeoPin}" Stroke="{DynamicResource Acc}"
                                                                       Thickness="2.4" IconSize="11" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                       Visibility="{Binding PinVisibility}" />
                                                        <TextBlock DockPanel.Dock="Left" FontSize="13.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Tx1}">
                                                            <Run Text="{Binding NameOnly, Mode=OneWay}" /><Run Text="{Binding HashTag, Mode=OneWay}" Foreground="{DynamicResource Tx3}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Note, Mode=OneWay}" Visibility="{Binding NoteVisibility}"
                                                                   FontSize="11.5" Foreground="{DynamicResource Tx3}" VerticalAlignment="Center"
                                                                   Margin="7,1,0,0" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <DockPanel Margin="0,2,0,0">
                                                        <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{DynamicResource Fresh}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <Border x:Name="RegionPill" DockPanel.Dock="Left" CornerRadius="4" Padding="5,1" Margin="0,0,6,0"
                                                                VerticalAlignment="Center" Background="{DynamicResource TagBg}"
                                                                Visibility="{Binding RegionVisibility}">
                                                            <TextBlock x:Name="RegionTx" Text="{Binding RegionText, Mode=OneWay}" FontSize="10.5"
                                                                       Foreground="{DynamicResource Tx3}" />
                                                        </Border>
                                                        <!-- 令牌失效的号:标出来,不然用户只会反复白切 -->
                                                        <Border DockPanel.Dock="Left" CornerRadius="4" Padding="5,1" Margin="0,0,6,0"
                                                                VerticalAlignment="Center" Background="{DynamicResource WarnBg}"
                                                                Visibility="{Binding ExpiredVisibility}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ctrl:IconView Geometry="{StaticResource GeoWarn}" Stroke="{DynamicResource WarnIc}"
                                                                               Thickness="2.6" IconSize="10" Margin="0,0,3,0" />
                                                                <TextBlock Text="登录已过期" FontSize="10.5" Foreground="{DynamicResource WarnTx}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock DockPanel.Dock="Left" FontSize="11.5" Foreground="{DynamicResource Tx3}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding SavedRelative, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding AccountIdText, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <!-- 段位:账号编号后面,一个定位一个 pill,全部展开 -->
                                                        <ItemsControl ItemsSource="{Binding RankRoles}" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border CornerRadius="4" Padding="4,1" Margin="0,0,5,0"
                                                                            VerticalAlignment="Center" Background="{DynamicResource TagBg}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Image Source="{Binding Icon}" Width="13" Height="13" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding RoleCn, Mode=OneWay}" FontSize="10.5" Margin="0,0,3,0"
                                                                                       Foreground="{DynamicResource Tx3}" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding Text, Mode=OneWay}" FontSize="10.5"
                                                                                       Foreground="{Binding Brush}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DockPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- 国际服/亚服的号用主题色标出来:一屏基本都是国服,挑出来的才有意义 -->
                                            <DataTrigger Binding="{Binding IsCnRegion}" Value="False">
                                                <Setter TargetName="RegionPill" Property="Background" Value="{DynamicResource AccSoft}" />
                                                <Setter TargetName="RegionTx" Property="Foreground" Value="{DynamicResource Acc}" />
                                            </DataTrigger>
                                            <!-- 过期的号按钮换成警告色:它做的事已经不是「切换」了 -->
                                            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                <Setter TargetName="GoPill" Property="Background" Value="{DynamicResource WarnBg}" />
                                                <Setter TargetName="GoText" Property="Foreground" Value="{DynamicResource WarnTx}" />
                                                <Setter TargetName="GoIcon" Property="Geometry" Value="{StaticResource GeoUser}" />
                                                <Setter TargetName="GoIcon" Property="Stroke" Value="{DynamicResource WarnIc}" />
                                            </DataTrigger>
                                            <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource AccBd}" />
                                                <Setter TargetName="GoPill" Property="Background" Value="{DynamicResource Acc}" />
                                                <Setter TargetName="GoText" Property="Foreground" Value="{DynamicResource OnAcc}" />
                                                <Setter TargetName="GoIcon" Property="Stroke" Value="{DynamicResource OnAcc}" />
                                                <Setter TargetName="DelBtn" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger SourceName="DelBtn" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DelIcon" Property="Stroke" Value="{DynamicResource Danger}" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding UnsavedCountText}" Margin="2,8,0,9" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Tx3}" Visibility="{Binding UnsavedVisibility}" />
                            <ItemsControl ItemsSource="{Binding UnsavedAccounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="UnsavedRoot" HorizontalAlignment="Left"
                                                Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                Background="{DynamicResource Card2}" BorderBrush="{DynamicResource Bd3}"
                                                BorderThickness="1" CornerRadius="11" Padding="9,8" Margin="0,0,0,8">
                                            <Border.ContextMenu>
                                                <ContextMenu Style="{StaticResource CardMenu}" Opened="OnCardMenuOpened" Closed="OnCardMenuClosed">
                                                    <MenuItem Style="{StaticResource CardMenuItem}" Header="编辑备注" Click="OnEditNote" />
                                                    <MenuItem Style="{StaticResource CardMenuItem}" Header="{Binding PinMenuText}" Click="OnTogglePin" />
                                                    <Separator Style="{StaticResource CardMenuSeparator}" />
                                                    <MenuItem Style="{StaticResource CardMenuItemDanger}" Header="从列表移除" Click="OnHideCard" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource OffAv}">
                                                    <TextBlock Text="{Binding AvatarText}" Foreground="{DynamicResource OffAvTx}" FontSize="15" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border DockPanel.Dock="Right" CornerRadius="8" Background="{DynamicResource TagBg}" Padding="12,6" VerticalAlignment="Center"
                                                        Cursor="Hand" MouseLeftButtonUp="OnSaveHint">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ctrl:IconView Geometry="{StaticResource GeoCam}" Stroke="{DynamicResource Tx2}" Thickness="2" IconSize="14" Margin="0,0,5,0" />
                                                        <TextBlock Text="保存快照" Foreground="{DynamicResource Tx2}" FontSize="12.5" />
                                                    </StackPanel>
                                                </Border>
                                                <Button x:Name="HideBtn" DockPanel.Dock="Right" Style="{StaticResource TitleIconButton}"
                                                        Width="30" Height="30" Margin="0,0,4,0" Click="OnHideCard" ToolTip="从列表移除(不影响战网)"
                                                        Visibility="Collapsed">
                                                    <ctrl:IconView x:Name="HideIcon" Geometry="{StaticResource GeoDelete}" Stroke="{DynamicResource Tx3}" Thickness="2" IconSize="15" />
                                                </Button>
                                                <StackPanel Margin="11,0" VerticalAlignment="Center">
                                                    <DockPanel>
                                                        <ctrl:IconView DockPanel.Dock="Left" Geometry="{StaticResource GeoPin}" Stroke="{DynamicResource Acc}"
                                                                       Thickness="2.4" IconSize="11" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                       Visibility="{Binding PinVisibility}" />
                                                        <TextBlock DockPanel.Dock="Left" FontSize="13.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource OffTx}">
                                                            <Run Text="{Binding NameOnly, Mode=OneWay}" /><Run Text="{Binding HashTag, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Note, Mode=OneWay}" Visibility="{Binding NoteVisibility}"
                                                                   FontSize="11.5" Foreground="{DynamicResource Tx3}" VerticalAlignment="Center"
                                                                   Margin="7,1,0,0" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <DockPanel Margin="0,2,0,0">
                                                        <Border x:Name="RegionPill2" DockPanel.Dock="Left" CornerRadius="4" Padding="5,1" Margin="0,0,6,0"
                                                                VerticalAlignment="Center" Background="{DynamicResource TagBg}"
                                                                Visibility="{Binding RegionVisibility}">
                                                            <TextBlock x:Name="RegionTx2" Text="{Binding RegionText, Mode=OneWay}" FontSize="10.5"
                                                                       Foreground="{DynamicResource Tx3}" />
                                                        </Border>
                                                        <TextBlock DockPanel.Dock="Left" FontSize="11.5" Foreground="{DynamicResource Tx3}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="未保存 · " /><Run Text="{Binding AccountIdText, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <!-- 段位:账号编号后面,一个定位一个 pill,全部展开 -->
                                                        <ItemsControl ItemsSource="{Binding RankRoles}" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border CornerRadius="4" Padding="4,1" Margin="0,0,5,0"
                                                                            VerticalAlignment="Center" Background="{DynamicResource TagBg}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Image Source="{Binding Icon}" Width="13" Height="13" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding RoleCn, Mode=OneWay}" FontSize="10.5" Margin="0,0,3,0"
                                                                                       Foreground="{DynamicResource Tx3}" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding Text, Mode=OneWay}" FontSize="10.5"
                                                                                       Foreground="{Binding Brush}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DockPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCnRegion}" Value="False">
                                                <Setter TargetName="RegionPill2" Property="Background" Value="{DynamicResource AccSoft}" />
                                                <Setter TargetName="RegionTx2" Property="Foreground" Value="{DynamicResource Acc}" />
                                            </DataTrigger>
                                            <Trigger SourceName="UnsavedRoot" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HideBtn" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger SourceName="HideBtn" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HideIcon" Property="Stroke" Value="{DynamicResource Danger}" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== 底栏 ===== -->
        <Border Grid.Row="2" Background="{DynamicResource Win}" BorderBrush="{DynamicResource Bd2}" BorderThickness="0,1,0,0">
            <Grid Margin="16,10">
                <StackPanel Orientation="Horizontal" DataContext="{Binding BottomBanner}"
                            Visibility="{Binding BannerVisibility}" Cursor="Hand" Background="Transparent"
                            MouseLeftButtonUp="OnBottomBannerClick">
                    <Border Background="{DynamicResource TagBg}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="AD" Foreground="{DynamicResource TagTx}" FontSize="10" />
                    </Border>
                    <Image Source="{Binding ImageUrl}" Visibility="{Binding ImageVisibility}" MaxHeight="28"
                           Stretch="Uniform" Margin="8,0,0,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Text}" Visibility="{Binding TextVisibility}" Foreground="{DynamicResource TagTx}"
                               FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="620" />
                    <TextBlock Text="{Binding CountLabel}" Visibility="{Binding CountVisibility}" Foreground="{DynamicResource Tx3}"
                               FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TotalCountText}" Foreground="{DynamicResource Tx3}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="去广告" Foreground="{DynamicResource Acc}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                               Cursor="Hand" MouseLeftButtonUp="OnRemoveAd"
                               Visibility="{Binding RemoveAdVisibility}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 模态弹窗时盖一层半透明遮罩(dim),对齐原型 .ov 的 mask -->
        <Border x:Name="DimOverlay" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource Mask}"
                Visibility="Collapsed" />

        <!-- 忙碌遮罩:切号/保存期间盖住整窗,显示当前进行到哪一步。
             跨区服切号要等战网后台进程退出(十几秒),没有反馈会被当成卡死。 -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource Mask}"
                Visibility="{Binding BusyVisibility}">
            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Bd3}" BorderThickness="1"
                    CornerRadius="14" Padding="26,22" MaxWidth="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <ctrl:IconView Geometry="{StaticResource GeoRefresh}"
                                   Stroke="{DynamicResource Acc}" Thickness="2.4" IconSize="30"
                                   HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <ctrl:IconView.RenderTransform>
                            <RotateTransform />
                        </ctrl:IconView.RenderTransform>
                        <ctrl:IconView.Style>
                            <!-- 转圈只由自己驱动:Style 里不能用 TargetName 指别的元素 -->
                            <Style TargetType="{x:Type ctrl:IconView}" BasedOn="{StaticResource {x:Type ctrl:IconView}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Busy}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinStory">
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0" To="360" Duration="0:0:1.1" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinStory" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctrl:IconView.Style>
                    </ctrl:IconView>
                    <TextBlock Text="{Binding StatusText}" Margin="0,16,0,0" FontSize="13"
                               Foreground="{DynamicResource Tx1}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="请勿手动开关战网" Margin="0,8,0,0" FontSize="11.5"
                               Foreground="{DynamicResource Tx3}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
