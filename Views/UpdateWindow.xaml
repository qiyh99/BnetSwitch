<Window x:Class="BnetSwitch.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen"
        SizeToContent="Height" Width="430" FontFamily="Microsoft YaHei UI" FontSize="13" Topmost="True">
    <Border Background="{DynamicResource Win}" CornerRadius="12" Margin="16"
            BorderBrush="{DynamicResource Bd}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <StackPanel Margin="24,22">
            <TextBlock Text="发现新版本" Foreground="{DynamicResource Tx1}" FontWeight="SemiBold" FontSize="16" />
            <TextBlock x:Name="VerText" Foreground="{DynamicResource Acc}" FontSize="13.5" Margin="0,6,0,0" />

            <Border Background="{DynamicResource Card}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                    BorderBrush="{DynamicResource Bd2}" BorderThickness="1" MaxHeight="150">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="NotesText" Foreground="{DynamicResource Tx2}" FontSize="12.5"
                               TextWrapping="Wrap" LineHeight="20" />
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="StatusText" Foreground="{DynamicResource Tx3}" FontSize="12"
                       Margin="0,12,0,0" TextWrapping="Wrap" />
            <ProgressBar x:Name="Bar" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100"
                         Foreground="{DynamicResource Acc}" Background="{DynamicResource Bd2}"
                         BorderThickness="0" Visibility="Collapsed" />

            <TextBlock x:Name="HintText" Foreground="{DynamicResource Tx3}"
                       FontSize="11.5" Margin="0,12,0,0" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="ExitBtn" Click="OnExit" Style="{StaticResource GhostButton}"
                        Height="34" Padding="16,0" Margin="0,0,8,0" />
                <Button x:Name="UpdBtn" Content="立即更新" Click="OnUpdate" Style="{StaticResource AccentButton}"
                        Height="34" Padding="22,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
